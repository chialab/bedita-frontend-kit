{
    "name": "chialab/frontend-kit",
    "description": "BEdita 6 plugin to help with development of websites.",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "ext-json": "*",
        "bedita/api": "^6.16",
        "bedita/core": "^6.16",
        "bedita/i18n": "^6.0",
        "cakephp/authentication": "^3.3.2",
        "cakephp/cakephp": "^5.4.2",
        "cakephp/twig-view": "^2.0",
        "chialab/ip": "^1.0"
    },
    "require-dev": {
        "bedita/placeholders": "^4.0",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/plugin-installer": "^2.0",
        "phpunit/phpunit": "^12.5.1",
        "league/flysystem-memory": "^3.29"
    },
    "suggest": {
        "bedita/placeholders": "To manage placeholders in templates",
        "chialab/rna-cakephp": "To manage JavaScript and CSS bundles with RNA"
    },
    "autoload": {
        "psr-4": {
            "Chialab\\FrontendKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEdita\\Core\\Test\\": "vendor/bedita/core/tests/",
            "Chialab\\FrontendKit\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "scripts": {
        "cs-check": "vendor/bin/phpcs",
        "cs-fix": "vendor/bin/phpcbf",
        "test": "vendor/bin/phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
